.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Quarto HTML dependency byproducts in the source tree. The rendered site under
# _site/ is no longer tracked at all (see /_site/ above): it is deployed with
# `quarto publish netlify`, not from git.
content/**/index_files/

# Marker touched by Publish-Website.command after each successful publish; it
# is what "changed since last publish" is measured against, so it is local.
.quarto-last-publish

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mkdocs documentation
/site


**/*.quarto_ipynb

# Lecture decks rendered for presenting. They are excluded from the project
# render list (see _quarto.yml) so that they are not built into _site/ and
# cannot reach the students before the lecture; rendering one by hand writes
# the .html next to its .qmd instead, which is a local build artifact.
content/lecture/slides/*.html

# Quarto's freeze cache. It is a local build artifact: the site is rendered on
# this machine and uploaded as finished HTML by `quarto publish netlify`, so
# Netlify never needs it, and renv.lock is what makes a rebuild reproducible.
# Keeping it out of git avoids the churn it caused in every commit.
_freeze/
